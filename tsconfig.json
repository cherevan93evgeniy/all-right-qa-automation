{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "pages/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "reporters/**/*.ts",
    "test-data/**/*.ts",
    "api/**/*.ts"
  ]
}
